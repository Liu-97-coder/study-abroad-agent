{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "① 端到端自测（smoke_test）",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/smoke_test.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": { "PYTHONIOENCODING": "utf-8" },
      "justMyCode": false
    },
    {
      "name": "② 启动 FastAPI（可断点）",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["ai_agent_core.main:app", "--port", "8000", "--reload"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": { "PYTHONIOENCODING": "utf-8" },
      "justMyCode": false
    },
    {
      "name": "③ RAG 检索诊断（改这里的 query）",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/check_rag.py",
      "args": ["--collection", "school", "--query", "英国 计算机硕士", "--country", "英国", "--top", "5"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": { "PYTHONIOENCODING": "utf-8" }
    },
    {
      "name": "④ 调试当前打开的文件",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": { "PYTHONIOENCODING": "utf-8" },
      "justMyCode": false
    }
  ]
}
