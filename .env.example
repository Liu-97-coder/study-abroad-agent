# ===== LLM 统一调度 =====
# mock：不调真实模型，用规则+模板兜底，零成本跑通全流程（默认）
# deepseek / openai / ollama：OpenAI 兼容协议
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL_BIG=deepseek-chat
LLM_MODEL_SMALL=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_TIMEOUT=60
LLM_CACHE_TTL=3600

# ===== RAG =====
# local：本地 JSON 索引，零依赖；milvus：需 pip install pymilvus milvus-lite
RAG_BACKEND=local
# 连独立 Milvus 服务时填 http://127.0.0.1:19530；留空则用下面的本地文件
MILVUS_SERVER_URI=
MILVUS_LOCAL_PATH=./runtime/milvus_demo.db
EMBED_BACKEND=hashing
EMBED_DIM=1024
RAG_TOP_K=20
RAG_RERANK_TOP=8

# ===== OCR =====
# stub：文本/PDF，图片自动尝试 rapidocr
# rapidocr：图片 OCR（pip install rapidocr-onnxruntime pillow，Windows 推荐）
# paddleocr：文档原始方案（pip install paddleocr paddlepaddle，体积大）
OCR_BACKEND=stub

# ===== 调度 =====
USE_LANGGRAPH=1
GRAPH_MAX_STEPS=12

# ===== 安全护栏 =====
SAFETY_STRICT=1
SAFETY_BLOCK_LEVEL=high

# ===== 鉴权 =====
# 1=开启（控制台需要登录）；0=关闭（本地脚本/测试用，所有人视为管理员）
AUTH_ENABLED=1
# 生产必须换成随机长字符串：python -c "import secrets;print(secrets.token_urlsafe(32))"
AUTH_SECRET=dev-secret-change-me-in-production
AUTH_TTL=28800
AUTH_DEFAULT_ADMIN=admin
AUTH_DEFAULT_PASSWORD=admin123
