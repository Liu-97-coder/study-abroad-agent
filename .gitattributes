# 统一换行：代码用 LF，Windows 脚本保持 CRLF
* text=auto eol=lf

*.py      text eol=lf
*.md      text eol=lf
*.json    text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.html    text eol=lf
*.js      text eol=lf
*.css     text eol=lf
*.csv     text eol=lf

# Windows 批处理/脚本：原样保存，不做换行转换（必须 CRLF，否则会一闪而过）
*.bat     -text
*.ps1     -text
*.vbs     -text
*.cmd     -text

*.png     binary
*.jpg     binary
*.ico     binary
