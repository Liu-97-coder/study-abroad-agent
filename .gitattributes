# 统一换行：代码用 LF，Windows 脚本保持 CRLF
* text=auto eol=lf

*.py      text eol=lf
*.md      text eol=lf
*.json    text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.html    text eol=lf
*.js      text eol=lf
*.css     text eol=lf
*.csv     text eol=lf

# Windows 批处理必须是 CRLF，否则会一闪而过
*.bat     text eol=crlf
*.ps1     text eol=crlf
*.vbs     text eol=crlf

*.png     binary
*.jpg     binary
*.ico     binary
